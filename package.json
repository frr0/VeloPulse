{
  "name": "velopulse",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "author": {
    "name": "VeloPulse Development Team",
    "email": "team@velopulse.app"
  },
  "description": "VeloPulse - Smart Indoor Cycling Studio & Intervals.icu Athletic Analytics Platform",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest run src/utils/__tests__ worker/__tests__",
    "typecheck:worker": "tsc -p worker/tsconfig.json",
    "worker:dev": "npm run build && npx wrangler dev",
    "worker:deploy": "npm run build && npx wrangler deploy",
    "preview": "vite preview",
    "cap:sync": "npm run build && npx cap sync android",
    "cap:sync:all": "npm run build && npx cap sync",
    "cap:open": "npx cap open android",
    "ios:sync": "npm run build && npx cap sync ios",
    "ios:open": "npx cap open ios",
    "android:build": "npm run cap:sync && cd android && JAVA_HOME=~/.local/jdk21 ./gradlew assembleDebug && cp app/build/outputs/apk/debug/app-debug.apk ../VeloPulse.apk"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "^8.3.0",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.6.0",
    "@garmin/fitsdk": "^21.218.0",
    "@supabase/supabase-js": "^2.119.2",
    "@types/leaflet": "^1.9.22",
    "@types/three": "^0.187.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.4",
    "tailwind-merge": "^3.5.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/web-bluetooth": "^0.0.20",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
    "vite": "^6.0.7",
    "vitest": "^5.1.1"
  }
}
