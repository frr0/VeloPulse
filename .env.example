# =============================================================================
# VeloPulse - Environment Variables Example
# Copy to `.env.local` for local development, or configure in Cloudflare Pages
# =============================================================================

# --- Supabase (Required for Webapp Auth + Database) ---
# Get these from Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- Optional: CARTO Basemap Key ---
VITE_CARTO_KEY=

# --- Optional: Strava OAuth (Server-side Cloudflare Pages Functions ONLY) ---
# Set these in Cloudflare Pages -> Settings -> Environment Variables (Encrypted)
# NEVER prefix secrets with VITE_!
# STRAVA_CLIENT_ID=your-strava-client-id
# STRAVA_CLIENT_SECRET=your-strava-client-secret
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
