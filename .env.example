# =============================================================================
# VeloPulse - Environment Variables Example
# Copy to `.env.local` for local development, or configure in Cloudflare Pages
# =============================================================================

# --- Supabase (Required for Webapp Auth + Database) ---
# Get these from Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- Optional: CARTO Basemap Key ---
VITE_CARTO_KEY=

# Phone app only: Worker that serves /api/* (defaults to the deployed workers.dev URL)
VITE_API_BASE_URL=

# --- Optional: Strava (server-side Worker secrets ONLY) ---
# Production: `npx wrangler secret put <NAME>` for each value below.
# Local `wrangler dev`: put them in `.dev.vars` (git-ignored).
# NEVER prefix secrets with VITE_!
# STRAVA_CLIENT_ID=your-strava-client-id
# STRAVA_CLIENT_SECRET=your-strava-client-secret
# STRAVA_STATE_SECRET=output-of-openssl-rand-base64-32
# STRAVA_TOKEN_KEY=output-of-openssl-rand-base64-32   (encrypts tokens in the DB; if lost, users reconnect Strava)
# STRAVA_WEBHOOK_VERIFY_TOKEN=any-random-string-you-choose
# STRAVA_WEBHOOK_SUBSCRIPTION_ID=id-returned-when-creating-the-subscription
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
